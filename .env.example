# Application
BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Local dev default (SQLite). On Railway, set DATABASE_URL from the Postgres plugin.
DATABASE_URL=sqlite:///./data/monitor.db

POLL_INTERVAL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=30
MAX_PRODUCTS_PER_USER=20
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SIGNUP_RATE_LIMIT=5/hour
NOTIFICATION_PREFERENCE_RATE_LIMIT=20/hour

# Email via Resend (https://resend.com — free tier available)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Legacy global notification setting (unused by per-user dispatcher)
NOTIFICATION_CHANNEL=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
WEBHOOK_URL=


WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=product_update
WHATSAPP_API_VERSION=v23.0