# Core Application & Security
BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite local dev default, PostgreSQL for deployment)
# Example Postgres: postgresql://user:password@localhost:5432/hmt_monitor
DATABASE_URL=sqlite:///./data/monitor.db

# Polling & Topology
POLL_INTERVAL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=30
ENABLE_SCHEDULER=true
MAX_PRODUCTS_PER_USER=20

# CORS Origins & Frontend Environment
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8000

# Email Delivery (Resend API)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=notifications@yourdomain.com

# ntfy Push Notifications
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=hmt_watches
NTFY_MAX_RETRIES=3
NTFY_RETRY_BACKOFF_SECONDS=2.0

# Rate Limits & Security
SIGNUP_RATE_LIMIT=5/hour
NOTIFICATION_PREFERENCE_RATE_LIMIT=20/hour
EMAIL_VERIFICATION_EXPIRE_HOURS=24