{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hmt-watch-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hmt-db",
      "database_id": "hmt-db"
    }
  ]
}
